{
    # Vercel 프록시 뒤의 실제 클라이언트 IP(X-Forwarded-For)를 API로 전달 — rate limit이 IP별로 동작하게.
    # api 포트는 외부에 노출되지 않으므로 uvicorn은 Caddy가 넘긴 XFF를 신뢰한다(Dockerfile).
    servers {
        trusted_proxies static 0.0.0.0/0 ::/0
    }
}

(api_common) {
    encode gzip zstd
    log {
        output file /var/log/caddy/access.log
        format json
    }
    request_body {
        max_size 10MB
    }
}

# 원래 도메인 (suim-app.store 만료로 현재 미사용, 재등록 시 그대로 복구됨)
api.spendlens.suim-app.store {
    import api_common
    reverse_proxy api:8000
}

# 임시 호스트 — 웹(Vercel)이 /api/* 를 이 호스트로 프록시한다 (apps/web/vercel.json).
# 브라우저에서 보이는 경로가 /api/auth/* 이므로 refresh 쿠키 Path를 맞춰준다.
api-3-38-103-25.sslip.io {
    import api_common
    reverse_proxy api:8000 {
        header_down Set-Cookie "Path=/auth" "Path=/api/auth"
    }
}
