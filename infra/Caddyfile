(api_common) {
    encode gzip zstd
    log {
        output file /var/log/caddy/access.log
        format json
    }
    request_body {
        max_size 10MB
    }
}

# 원래 도메인 (suim-app.store 만료로 현재 미사용, 재등록 시 그대로 복구됨)
api.spendlens.suim-app.store {
    import api_common
    reverse_proxy api:8000
}

# 임시 호스트 — 웹(Vercel)이 /api/* 를 이 호스트로 프록시한다 (apps/web/vercel.json).
# 브라우저에서 보이는 경로가 /api/auth/* 이므로 refresh 쿠키 Path를 맞춰준다.
api-3-38-103-25.sslip.io {
    import api_common
    reverse_proxy api:8000 {
        header_down Set-Cookie "Path=/auth" "Path=/api/auth"
    }
}
